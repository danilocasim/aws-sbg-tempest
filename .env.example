# Keys only, never values. Real values live in Coolify (prod) or your local .env (dev).
# Both apps read the same keys; local defaults match docker/compose.yaml.

DATABASE_URL=postgres://tempest:tempest@localhost:5433/tempest
AUTH_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
UPLOADS_DIR=./uploads

# Email: SMTP_URL wins when set (local mailpit). Otherwise EMAIL_API_KEY → Resend HTTP API.
SMTP_URL=smtp://localhost:1025
EMAIL_API_KEY=
EMAIL_FROM="Tempest <no-reply@tempest.example>"

# Backups (docker/backup): off-box rclone remote + age public key for encryption.
RCLONE_REMOTE=
AGE_PUBLIC_KEY=
BACKUP_RETENTION_DAYS=30
